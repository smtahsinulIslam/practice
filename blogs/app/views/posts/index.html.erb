<div>

  <div>
    <h1>Posts</h1>
  </div>

  <div>
  <% @posts.each do |post| %>
    <%= link_to "X delete", post, method: :delete, confirm: "Are you sure?" %>
    <p><%= post.title %></p>
    <p><%= post.description %></p>
    <p><%= post.comments.count %> comments</p>
    <%= link_to "View Post", post %>
    <%= link_to "Edit Post", edit_post_path(post) %>

    <hr>
  <% end %>  
  </div>

</div>