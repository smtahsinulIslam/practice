<div class="main_div">
  <div class="post">
    <h1><%= @post.title %></h1>
    <p><%= @post.description %></p>
    <p>Author: <%= link_to @post.user.name, @post.user %></p>
  </div>
  <div class="comment">
    <h2>Comments</h2>
    <% @post.comments.each do |comment| %>
    <hr>
      <p><%= comment.statement %></p>
      <p>Commented by: <%= link_to comment.user.name, comment.user %></p>
      <% if current_user == comment.user %>
        <div class="comment-actions">
          <%= link_to "Edit Comment", edit_post_comment_path(@post, comment), class: "btn-green" %> 
          <%= link_to "Destroy", [@post, comment], class: "btn-danger", 
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
    <% end %>
    <br>
    <hr>  
    <div>
      <% if user_signed_in? %>
        <div class="comment-form">
          <h2>Add a Comment</h2>
          
          <%= form_with model: [@post, Comment.new], local: true do |form| %>
            <% if form.object.errors.any? %>
              <div style="color: red;">
                <h2><%= pluralize(form.object.errors.count, "error ")%> Found!</h2>
              </div>
            <% end %>
              <div>
                <%= form.label :statement, "Your Comment" %>
                <br>
                <%= form.text_area :statement, class: "textarea" %>
                <% if @statement == nil %>
                  <p style="color: red;"><%= "*Write in the statement field to add a comment*" %></p>
                <% end %>
              </div>
              
              <div>
                <%= form.submit "Create Comment", class: "btn-green" %>
              </div>
          <% end %>
          </div>
      <% else %>
        <h3>
          Please<%= link_to " Log in ", new_user_session_path %>to add a comment.
        </h3>
      <% end %>

    </div>
  </div>
  <hr>
  <% if user_signed_in? %>
  <div class="show-actions">
    <br>
    <div>
    <% if current_user == @post.user %>
      <%= link_to "Edit Post", edit_post_path(@post), class: "btn-green" %> 
      <%= link_to "Delete Post", @post, class: "btn-danger", 
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    <% end %>
    </div>
  </div>
  <% end %>
  <br><br>
  <%= link_to "Back to Posts", posts_path, class: "btn-blue", style: "margin-left: 10px;" %>
  <br><br>
  
</div>