<h1><%= @post.title %></h1>
<p><%= @post.description %></p>
<p>Author: <%= link_to @post.user.name, @post.user %></p>
<h2>Comments</h2>
<% @post.comments.each do |comment| %>
  <p><%= comment.statement %></p>
  <p>Commented by: <%= link_to comment.user.name, comment.user %></p>
  <%= link_to "destroy", [@post, comment], data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
<% end %>

<hr>
<div>
<%= link_to "Add Comment", new_post_comment_path(@post) %> |
<%= link_to "Edit Post", edit_post_path(@post) %> |
<%= link_to "Delete Post", @post, method: :delete, confirm: "Are you sure?" %>
<br>
<%= link_to "Back to Posts", posts_path %>
</div>