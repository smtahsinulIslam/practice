<div class="header">
  <nav class="nav">
    <ul>
      <li>
        <%= link_to "Articles", 
        root_path %>
      </li>

      <% if user_signed_in? %>
        <li>
          <%= link_to "Add Posts", 
          new_post_path %>
        </li>

        <li>
          <%= link_to "User", 
          user_path(current_user) %>
        </li>

        <li>
          <%= link_to "Log Out", 
          destroy_user_session_path,
          class: "btn-danger", 
          data: { turbo_method: :delete } %>
        </li>

      <%else%>
          <li>
            <%= link_to "Sign Up", 
            new_user_path %>
          </li>

          <li>
            <%= link_to "Log In", 
            new_user_session_path %>
          </li>

      <% end %>
    </ul>
  </nav>
</div>