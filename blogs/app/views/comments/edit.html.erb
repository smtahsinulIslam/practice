<h1>Edit Comment</h1>
<div>
<%= form_with model: [@post, @comment], local: true do |form| %>
  <div>
    <%= form.label :statement %><br>
    <%= form.text_area :statement %>
  </div>
  <div>
    <%= form.label :user_id, "User" %><br>
    <%= form.collection_select :user_id, User.all, :id, :name %>
  </div>
  <div>
    <%= form.submit "Update Comment" %>
  </div>
<% end %>
<%= link_to "Back to Post", @post %>
</div>    