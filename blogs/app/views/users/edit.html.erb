<div class="">
<h1>Create User</h1>
<%= form_with model: @user, local: true do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>
<br>

  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
  </div>
<br>

  <div>
    <%= form.label :number %><br>
    <%= form.telephone_field :number %>
  </div>
<br>

  <div>
    <%= form.submit "Update User", class: "btn-green" %>
  </div>
<% end %>
<br>
<%= link_to "Back to Users", users_path, class: "btn-blue" %>
<br>
</div>