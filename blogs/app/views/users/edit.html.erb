<h1>Edit User</h1>
<%= form_with model: @user, local: true do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :number %>
    <%= form.telephone_field :number %>
  </div>

  <%= form.submit "Update User" %>
<% end %>
<%= link_to "Back to Users", users_path %>