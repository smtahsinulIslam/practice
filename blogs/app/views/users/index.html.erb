<div>
  <h1>Users</h1>
  <div>
    <% @users.each do |user| %>
      <p><%= user.name %></p>
      <p><%= user.email %></p>
      <p><%= user.number %></p>
      <%= link_to "View User", user %> |
      <%= link_to "Edit User", edit_user_path(user) %> |
      <%= button_to "Delete User", user, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      <hr>
    <% end %>
  </div>
  <%= link_to "New User", new_user_path %>
</div>