<div class="">
  <h1>Users</h1>
  <div class="users">
    <% @users.each do |user| %>
      <h2><%= user.name %></h2>
      <p><%= user.email %></p>
      <p><%= user.number %></p>
      <%= link_to "View User", user, class: "btn-blue" %> 
      <% if current_user == user %>
      <%= link_to "Edit User", edit_user_path(user), class: "btn-green" %> 
      <br> <br>
      <%= link_to "Delete User", user, class: "btn-danger", 
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      <hr>
    <% end %>
    <% end %>
  </div>
  <br><br>
</div>