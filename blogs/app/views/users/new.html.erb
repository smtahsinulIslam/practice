<div class="">
<h1>Create User</h1>
<%= form_with model: @user, local: true do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@user.errors.count, "error ")%> Found!</h2>
    </div>
  <% end %>

  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
    <% if @user.errors[:name].any? %>
      <% @user.errors.full_messages_for(:name).each do |message| %>
        <p style="color: red;"><%= message %></p>
      <% end %>
  <% end %>
  </div>
<br>

  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
    <% if @user.errors[:email].any? %>
      <% @user.errors.full_messages_for(:email).each do |message| %>
        <p style="color: red;"><%= message %></p>
      <% end %>
  <% end %>
  </div>
<br>

  <div>
    <%= form.label :number %><br>
    <%= form.telephone_field :number %>
    <% if @user.errors[:number].any? %>
      <% @user.errors.full_messages_for(:number).each do |message| %>
        <p style="color: red;"><%= message %></p>
      <% end %>
  <% end %>
  </div>
<br>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password %>
    <% if @user.errors[:password].any? %>
      <% @user.errors.full_messages_for(:password).each do |message| %>
        <p style="color: red;"><%= message %></p>
      <% end %>
    <% end %>
  </div>
<br>

  <div>
    <%= form.label :password_confirmation %><br>
    <%= form.password_field :password_confirmation %>
    <% if @user.errors[:password_confirmation].any? %>
      <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
        <p style="color: red;"><%= message %></p>
      <% end %>
  <% end %>
  </div>
<br>

  <div>
    <%= form.submit "Create User", class: "btn-green" %>
  </div>
<% end %>
<br>
<%= link_to "Back to Users", users_path, class: "btn-blue" %>
<br>
</div>