<h1>Create User</h1>
<%= form_with model: @user, local: true do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :number %><br>
    <%= form.telephone_field :number %>
  </div>

  <div>
    <%= form.submit "Create User" %>
  </div>
<% end %>
<%= link_to "Back to Users", users_path %>